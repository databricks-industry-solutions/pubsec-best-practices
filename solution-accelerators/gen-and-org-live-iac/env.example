# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# The account-level exporter needs an ACCOUNT-ADMIN service principal (OAuth M2M),
# not just user OAuth.

# Accounts console host (commercial AWS shown; staging = accounts.staging.cloud.databricks.com)
DATABRICKS_HOST=https://accounts.cloud.databricks.com

# E2 account UUID (Accounts console → top-right user menu)
DATABRICKS_ACCOUNT_ID=

# Account-admin service principal OAuth secret
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# Optional: to also capture workspace-scoped compute/SQL, run a second pass with
# DATABRICKS_HOST pointed at a workspace and LISTING/SERVICES set to compute,sql-endpoints.
# For a whole fleet, prefer the manifest-driven fan-out: cp fleet.example.conf fleet.conf.

# ── Exporter parallelism / rate-limit tuning (read straight from the environment) ──
# On a large account these throttle the exporter to avoid 429s (turn DOWN), or speed
# a quiet one up (turn UP, cautiously). 01_export.sh exports them via `set -a`.
# EXPORTER_WS_LIST_PARALLELISM=2        # goroutines for workspace object listing (default 5)
# EXPORTER_PARALLELISM_SCIM=1           # per-resource-type goroutines: EXPORTER_PARALLELISM_<SERVICE>
